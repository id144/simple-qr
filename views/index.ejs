<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>QR Code Generator</title>
  <link rel="stylesheet" href="/style.css">
</head>
<script>
var value = document.getElementById("QRSizeValue");
var input = document.getElementById("QRSize");
value.textContent = input.value;
input.addEventListener("input", (event) => {
  value.textContent = event.target.value;
});

</script>
<body>
  <div class="container">
    <h1>QR Code Generator</h1>
    
    <form action="/" method="POST">
      <label for="url">Enter URL:</label>
      <input type="text" id="url" name="url" placeholder="https://mozartmuseum.cz" required>
	<br>	
      <label for="errorCorrectionLevel">Correction Level:</label>
      <select id="errorCorrectionLevel" name="errorCorrectionLevel">
        <option value="L" <% if (errorCorrectionLevel === 'L') { %> selected <% } %>>L (Low, 7% recovery)</option>
        <option value="M" <% if (errorCorrectionLevel === 'M') { %> selected <% } %> selected>M (Medium, 15% recovery)</option>
        <option value="Q" <% if (errorCorrectionLevel === 'Q') { %> selected <% } %>>Q (Quartile, 25% recovery)</option>
        <option value="H" <% if (errorCorrectionLevel === 'H') { %> selected <% } %>>H (High, 30% recovery)</option>
      </select>
	<br>
      <label for="QRSize">QR code size:</label>
	<input type="range" id="QRSize" name="QRSize" min="4" max="32" value="16" step="2"/>
	<p>Value: <output id="QRSizeValue"></output></p>
      <button type="submit">Generate QR Code</button>
    </form>

    <% if (qrCodeUrl) { %>
      <h2>Your QR Code:</h2>
      <img src="<%= qrCodeUrl %>" alt="Generated QR Code">

      <h3>URL:</h3>
      <p><a href="<%= originalUrl %>" target="_blank"><%= originalUrl %></a></p>
    <% } %>

    <% if (error) { %>
      <p class="error"><%= error %></p>
    <% } %>
  </div>
</body>
</html>