<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>QR Code Generator</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="container">
    <h1>QR Code Generator</h1>
    
    <form action="/" method="POST">
      <label for="url">Enter URL:</label>
      <input type="text" id="url" name="url" placeholder="https://example.com" required>

      <label for="errorCorrectionLevel">Error Correction Level:</label>
      <select id="errorCorrectionLevel" name="errorCorrectionLevel">
        <option value="L" <% if (errorCorrectionLevel === 'L') { %> selected <% } %>>L (Low, 7% recovery)</option>
        <option value="M" <% if (errorCorrectionLevel === 'M') { %> selected <% } %>selected>M (Medium, 15% recovery)</option>
        <option value="Q" <% if (errorCorrectionLevel === 'Q') { %> selected <% } %>>Q (Quartile, 25% recovery)</option>
        <option value="H" <% if (errorCorrectionLevel === 'H') { %> selected <% } %>>H (High, 30% recovery)</option>
      </select>

      <button type="submit">Generate QR Code</button>
    </form>

    <% if (qrCodeUrl) { %>
      <h2>Your QR Code for <%= url %>:</h2>
      <img src="<%= qrCodeUrl %>" alt="Generated QR Code">
    <% } %>

    <% if (error) { %>
      <p class="error"><%= error %></p>
    <% } %>
  </div>
</body>
</html>